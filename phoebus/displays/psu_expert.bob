  <widget type="action_button" version="3.0.0">
    <name>Action_14</name>
    <x>870</x>
    <y>182</y>
    <width>135</width>
    <height>25</height>
    <pv_name>BDX:PSU:LV1:ALLOFF_CMD</pv_name>
    <actions>
      <action type="write_pv">
        <pv_name>BDX:PSU:LV1:ALLOFF_CMD</pv_name>
        <value>On</value>
        <description>Write On to BDX:PSU:LV1:ALLOFF_CMD</description>
      </action>
    </actions>
    <text>EXECUTE</text>
    <tooltip>$(actions)</tooltip>
    <confirm_dialog>true</confirm_dialog>
    <confirm_message>Execute all-off command BDX:PSU:LV1:ALLOFF_CMD?</confirm_message>
    <background_color>
      <color red="255" green="205" blue="120" />
    </background_color>
