{
  "version": 1,
  "defaults": {
    "minor_percent": 5,
    "minor_seconds": 5,
    "major_percent": 10,
    "major_seconds": 0,
    "major_sustained_percent": 5,
    "major_sustained_seconds": 20,
    "recovery_seconds": 5
  },
  "telegram": {
    "people": [],
    "major_people": [],
    "interlock_people": "all",
    "verify_membership": true,
    "membership_cache_seconds": 300
  },
  "alarm_templates": [
    {
      "for_each": [
        {
          "name": "lv1-ch1",
          "prefix": "BDX:PSU:LV1:CH1",
          "voltage_setpoint": "VOLTAGE_SET_RBV",
          "optional": false,
          "lv_monitoring": true
        },
        {
          "name": "lv1-ch2",
          "prefix": "BDX:PSU:LV1:CH2",
          "voltage_setpoint": "VOLTAGE_SET_RBV",
          "optional": false,
          "lv_monitoring": true
        },
        {
          "name": "lv2-ch1",
          "prefix": "BDX:PSU:LV2:CH1",
          "voltage_setpoint": "VOLTAGE_SET_RBV",
          "optional": false,
          "lv_monitoring": true
        },
        {
          "name": "lv2-ch2",
          "prefix": "BDX:PSU:LV2:CH2",
          "voltage_setpoint": "VOLTAGE_SET_RBV",
          "optional": false,
          "lv_monitoring": true
        },
        {
          "name": "hv1-ch1",
          "prefix": "BDX:HV:HV1:CH1",
          "voltage_setpoint": "VOLTAGE_SET",
          "optional": true,
          "lv_monitoring": false
        },
        {
          "name": "hv1-ch2",
          "prefix": "BDX:HV:HV1:CH2",
          "voltage_setpoint": "VOLTAGE_SET",
          "optional": true,
          "lv_monitoring": false
        }
      ],
      "alarms": [
        {
          "id": "{name}-voltage-deviation",
          "kind": "numeric",
          "label": "{name} voltage differs from the applied setpoint",
          "pv": "{prefix}:VOLTAGE_RBV",
          "mode": "deviation",
          "reference": {
            "pv": "{prefix}:{voltage_setpoint}"
          },
          "conditions": [
            {
              "pv": "{prefix}:OUTPUT_RBV",
              "operator": "truthy"
            }
          ],
          "group": "{name}-voltage",
          "optional": "{optional}",
          "overrides": {
            "minor_percent": 5,
            "minor_seconds": 10,
            "major_percent": 1000000,
            "major_seconds": 0,
            "major_sustained_percent": 5,
            "major_sustained_seconds": 60,
            "recovery_seconds": 5
          },
          "reference_floor": 0.2,
          "minimum_absolute_difference": 0.03
        },
        {
          "id": "{name}-output-mismatch",
          "kind": "comparison",
          "label": "{name} output readback differs from its setting",
          "pv": "{prefix}:OUTPUT_RBV",
          "operator": "eq",
          "reference": {
            "pv": "{prefix}:OUTPUT_SET"
          },
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 5
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "OUTPUT_RBV must equal OUTPUT_SET",
          "group": "{name}-output",
          "optional": "{optional}",
          "conditions": [
            {
              "pv": "{prefix}:OUTPUT_MONITOR_READY",
              "operator": "truthy"
            }
          ]
        },
        {
          "id": "{name}-ovp-proximity",
          "kind": "numeric",
          "label": "{name} voltage is close to or above OVP",
          "pv": "{prefix}:VOLTAGE_RBV",
          "mode": "ratio",
          "reference": {
            "pv": "{prefix}:OVP_RBV"
          },
          "conditions": [
            {
              "pv": "{prefix}:OUTPUT_RBV",
              "operator": "truthy"
            }
          ],
          "overrides": {
            "minor_percent": 95,
            "minor_seconds": 5,
            "major_percent": 100,
            "major_seconds": 0,
            "major_sustained_percent": 100,
            "major_sustained_seconds": 0
          },
          "group": "{name}-voltage-protection",
          "optional": "{optional}",
          "minimum_reference": 0.03
        },
        {
          "id": "{name}-ocp-trip",
          "kind": "state",
          "label": "{name} hardware OCP protection has tripped",
          "pv": "{prefix}:OCP_TRIPPED",
          "alarm_when": true,
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 0
            },
            {
              "level": "MAJOR",
              "after_seconds": 10
            },
            {
              "level": "INTERLOCK",
              "after_seconds": 20
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "hardware OCP trip must remain inactive",
          "group": "{name}-current-protection",
          "optional": "{optional}",
          "enabled": "{lv_monitoring}"
        },
        {
          "id": "{name}-current-change-2s",
          "kind": "comparison",
          "label": "{name} current changed by at least 10% within 2 seconds",
          "pv": "{prefix}:CURRENT_CHANGE_2S_PERCENT",
          "operator": "lt",
          "reference": {
            "value": 10
          },
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "2 s current change must remain below 10%",
          "group": "{name}-current-dynamics",
          "optional": "{optional}",
          "enabled": "{lv_monitoring}"
        },
        {
          "id": "{name}-current-change-10s",
          "kind": "comparison",
          "label": "{name} current changed by at least 10% within 10 seconds",
          "pv": "{prefix}:CURRENT_CHANGE_10S_PERCENT",
          "operator": "lt",
          "reference": {
            "value": 10
          },
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "10 s current change must remain below 10%",
          "group": "{name}-current-dynamics",
          "optional": "{optional}",
          "enabled": "{lv_monitoring}"
        },
        {
          "id": "{name}-voltage-span-major",
          "kind": "comparison",
          "label": "{name} voltage readback span exceeds 0.5 V over 30 seconds",
          "pv": "{prefix}:VOLTAGE_SPAN_30S",
          "operator": "lte",
          "reference": {
            "value": 0.5
          },
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "30 s voltage span must remain below 0.5 V",
          "group": "{name}-voltage-stability",
          "optional": "{optional}",
          "enabled": "{lv_monitoring}"
        },
        {
          "id": "{name}-voltage-span-minor",
          "kind": "comparison",
          "label": "{name} voltage readback span exceeds 0.1 V over 30 seconds",
          "pv": "{prefix}:VOLTAGE_SPAN_30S",
          "operator": "lte",
          "reference": {
            "value": 0.1
          },
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "30 s voltage span must remain below 0.1 V",
          "group": "{name}-voltage-stability",
          "optional": "{optional}",
          "enabled": "{lv_monitoring}"
        }
      ]
    },
    {
      "for_each": [
        {
          "name": "t00",
          "prefix": "BDX:ENV:TEMP:T00"
        },
        {
          "name": "t01",
          "prefix": "BDX:ENV:TEMP:T01"
        },
        {
          "name": "t02",
          "prefix": "BDX:ENV:TEMP:T02"
        },
        {
          "name": "t03",
          "prefix": "BDX:ENV:TEMP:T03"
        }
      ],
      "alarms": [
        {
          "id": "temperature-{name}-comfort-range",
          "kind": "range",
          "label": "Ambient temperature {name} is outside the 15-28 degC monitoring range",
          "pv": "{prefix}:VALUE",
          "minimum": 15,
          "maximum": 28,
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "group": "environment-{name}",
          "optional": true
        },
        {
          "id": "temperature-{name}-critical-range",
          "kind": "range",
          "label": "Ambient temperature {name} is below 10 degC or above 35 degC",
          "pv": "{prefix}:VALUE",
          "minimum": 10,
          "maximum": 35,
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 300
            }
          ],
          "recovery_seconds": 5,
          "group": "environment-{name}",
          "optional": true
        },
        {
          "id": "temperature-{name}-change-10m",
          "kind": "comparison",
          "label": "Ambient temperature {name} changed by at least 3 degC within 10 minutes",
          "pv": "{prefix}:CHANGE_10M",
          "operator": "lt",
          "reference": {
            "value": 3
          },
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "10 min temperature change must remain below 3 degC",
          "group": "environment-{name}-dynamics",
          "optional": true
        },
        {
          "id": "temperature-{name}-change-1h",
          "kind": "comparison",
          "label": "Ambient temperature {name} changed by at least 5 degC within one hour",
          "pv": "{prefix}:CHANGE_1H",
          "operator": "lt",
          "reference": {
            "value": 5
          },
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 0
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "1 h temperature change must remain below 5 degC",
          "group": "environment-{name}-dynamics",
          "optional": true
        },
        {
          "id": "temperature-{name}-health",
          "kind": "state",
          "label": "Temperature sensor {name} is unavailable",
          "pv": "{prefix}:STATUS_OK",
          "alarm_when": false,
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 10
            },
            {
              "level": "MAJOR",
              "after_seconds": 60
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "STATUS_OK must remain 1",
          "group": "environment-{name}",
          "optional": true
        },
        {
          "id": "temperature-{name}-stale",
          "kind": "stale",
          "label": "Temperature sensor {name} has stopped updating",
          "pv": "{prefix}:HEARTBEAT",
          "stale_after_seconds": 10,
          "timestamp_mode": "change",
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 0
            },
            {
              "level": "MAJOR",
              "after_seconds": 50
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "Sensor heartbeat must keep changing",
          "group": "environment-{name}",
          "optional": true
        }
      ]
    },
    {
      "for_each": [
        {
          "name": "humidity-h01",
          "prefix": "BDX:ENV:HUMIDITY:H01"
        },
        {
          "name": "pressure-p01",
          "prefix": "BDX:ENV:PRESSURE:P01"
        }
      ],
      "alarms": [
        {
          "id": "{name}-health",
          "kind": "state",
          "label": "Environmental sensor {name} is unavailable",
          "pv": "{prefix}:STATUS_OK",
          "alarm_when": false,
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 10
            },
            {
              "level": "MAJOR",
              "after_seconds": 60
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "STATUS_OK must remain 1",
          "group": "environment-{name}",
          "optional": true
        },
        {
          "id": "{name}-stale",
          "kind": "stale",
          "label": "Environmental sensor {name} has stopped updating",
          "pv": "{prefix}:HEARTBEAT",
          "stale_after_seconds": 10,
          "timestamp_mode": "change",
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 0
            },
            {
              "level": "MAJOR",
              "after_seconds": 50
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "Sensor heartbeat must keep changing",
          "group": "environment-{name}",
          "optional": true
        }
      ]
    },
    {
      "for_each": [
        {
          "name": "lv1",
          "prefix": "BDX:PSU:LV1",
          "optional": false
        },
        {
          "name": "lv2",
          "prefix": "BDX:PSU:LV2",
          "optional": false
        },
        {
          "name": "hv1",
          "prefix": "BDX:HV:HV1",
          "optional": true
        }
      ],
      "alarms": [
        {
          "id": "{name}-ioc-state",
          "kind": "comparison",
          "label": "{name} IOC is not running",
          "pv": "{prefix}:IOC_STATE",
          "operator": "eq",
          "reference": {
            "value": "RUNNING"
          },
          "stages": [
            {
              "level": "MAJOR",
              "after_seconds": 5
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "IOC_STATE must equal RUNNING",
          "group": "{name}-health",
          "optional": "{optional}"
        },
        {
          "id": "{name}-error-code",
          "kind": "comparison",
          "label": "{name} IOC reports an error",
          "pv": "{prefix}:ERROR_CODE",
          "operator": "eq",
          "reference": {
            "value": 0
          },
          "stages": [
            {
              "level": "MINOR",
              "after_seconds": 10
            },
            {
              "level": "MAJOR",
              "after_seconds": 60
            }
          ],
          "recovery_seconds": 5,
          "limit_description": "ERROR_CODE must equal 0",
          "group": "{name}-health",
          "optional": "{optional}"
        }
      ]
    }
  ],
  "alarms": [
    {
      "id": "global-interlock",
      "kind": "interlock",
      "label": "Global interlock has switched the system off",
      "pv": "BDX:GLOBAL:INTERLOCK_ACTIVE",
      "alarm_when": true,
      "activation_seconds": 0,
      "recovery_seconds": 1,
      "limit_description": "INTERLOCK_ACTIVE must remain Off (0)",
      "group": "global-safety"
    },
    {
      "id": "global-ready",
      "kind": "state",
      "label": "Global system is not ready",
      "pv": "BDX:GLOBAL:READY",
      "alarm_when": false,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 5
        },
        {
          "level": "MAJOR",
          "after_seconds": 120
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "READY must remain On (1)",
      "group": "global-health",
      "conditions": [
        {
          "pv": "BDX:GLOBAL:SYSTEM_STATE",
          "operator": "ne",
          "value": "STANDBY"
        },
        {
          "pv": "BDX:GLOBAL:SYSTEM_STATE",
          "operator": "ne",
          "value": "SAFE"
        }
      ]
    },
    {
      "id": "global-heartbeat-stale",
      "kind": "stale",
      "label": "Global IOC heartbeat is stale",
      "pv": "BDX:GLOBAL:HEARTBEAT",
      "stale_after_seconds": 10,
      "timestamp_mode": "change",
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 0
        },
        {
          "level": "MAJOR",
          "after_seconds": 50
        }
      ],
      "recovery_seconds": 2,
      "limit_description": "HEARTBEAT must change at least every 10 seconds",
      "group": "global-health"
    },
    {
      "id": "chiller-temperature-deviation",
      "kind": "numeric",
      "label": "Chiller temperature differs from its applied setpoint",
      "pv": "BDX:CHILLER:CHILLER1:TEMPERATURE_RBV",
      "mode": "deviation",
      "reference": {
        "pv": "BDX:CHILLER:CHILLER1:SETPOINT_RBV"
      },
      "group": "chiller-temperature",
      "conditions": [
        {
          "pv": "BDX:CHILLER:CHILLER1:RUN_RBV",
          "operator": "truthy"
        },
        {
          "pv": "BDX:CHILLER:CHILLER1:DEVIATION_SETTLING",
          "operator": "falsy"
        }
      ]
    },
    {
      "id": "chiller-communication",
      "kind": "state",
      "label": "Chiller communication is unavailable",
      "pv": "BDX:CHILLER:CHILLER1:COMM_OK",
      "alarm_when": false,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        },
        {
          "level": "MAJOR",
          "after_seconds": 60
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "COMM_OK must remain On (1)",
      "group": "chiller-health"
    },
    {
      "id": "chiller-heartbeat-stale",
      "kind": "stale",
      "label": "Chiller IOC heartbeat is stale",
      "pv": "BDX:CHILLER:CHILLER1:HEARTBEAT",
      "stale_after_seconds": 10,
      "timestamp_mode": "change",
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 0
        },
        {
          "level": "MAJOR",
          "after_seconds": 50
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "Chiller heartbeat must keep changing",
      "group": "chiller-health"
    },
    {
      "id": "chiller-ioc-state",
      "kind": "comparison",
      "label": "Chiller IOC is not running",
      "pv": "BDX:CHILLER:CHILLER1:IOC_STATE",
      "operator": "eq",
      "reference": {
        "value": "RUNNING"
      },
      "stages": [
        {
          "level": "MAJOR",
          "after_seconds": 5
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "IOC_STATE must equal RUNNING",
      "group": "chiller-health"
    },
    {
      "id": "chiller-error-code",
      "kind": "comparison",
      "label": "Chiller IOC reports an error",
      "pv": "BDX:CHILLER:CHILLER1:ERROR_CODE",
      "operator": "eq",
      "reference": {
        "value": 0
      },
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        },
        {
          "level": "MAJOR",
          "after_seconds": 60
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "ERROR_CODE must equal 0",
      "group": "chiller-health"
    },
    {
      "id": "chiller-stat-low-level",
      "kind": "state",
      "label": "Chiller coolant level is low",
      "pv": "BDX:CHILLER:CHILLER1:STAT_LOW_LEVEL",
      "alarm_when": true,
      "stages": [
        {
          "level": "MAJOR",
          "after_seconds": 60
        },
        {
          "level": "INTERLOCK",
          "after_seconds": 600
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT low-level bit must remain 0",
      "group": "chiller-low-level"
    },
    {
      "id": "chiller-stat-overtemperature",
      "kind": "state",
      "label": "Chiller reports overtemperature",
      "pv": "BDX:CHILLER:CHILLER1:STAT_OVERTEMPERATURE",
      "alarm_when": true,
      "stages": [
        {
          "level": "MAJOR",
          "after_seconds": 60
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT overtemperature bit must remain 0",
      "group": "chiller-stat-major"
    },
    {
      "id": "chiller-stat-general-error",
      "kind": "state",
      "label": "Chiller STAT general error bit is active",
      "pv": "BDX:CHILLER:CHILLER1:STAT_GENERAL_ERROR",
      "alarm_when": true,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT general-error bit must remain 0",
      "group": "chiller-stat-minor"
    },
    {
      "id": "chiller-stat-general-alarm",
      "kind": "state",
      "label": "Chiller STAT general alarm bit is active",
      "pv": "BDX:CHILLER:CHILLER1:STAT_GENERAL_ALARM",
      "alarm_when": true,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT general-alarm bit must remain 0",
      "group": "chiller-stat-minor"
    },
    {
      "id": "chiller-stat-general-warning",
      "kind": "state",
      "label": "Chiller STAT general warning bit is active",
      "pv": "BDX:CHILLER:CHILLER1:STAT_GENERAL_WARNING",
      "alarm_when": true,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT general-warning bit must remain 0",
      "group": "chiller-stat-minor"
    },
    {
      "id": "chiller-stat-reserved",
      "kind": "state",
      "label": "Chiller reserved STAT bit is unexpectedly active",
      "pv": "BDX:CHILLER:CHILLER1:STAT_RESERVED",
      "alarm_when": true,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT reserved bit must remain 0",
      "group": "chiller-stat-minor"
    },
    {
      "id": "chiller-stat-external-control",
      "kind": "state",
      "label": "Chiller external control value is missing",
      "pv": "BDX:CHILLER:CHILLER1:STAT_EXTERNAL_CONTROL_MISSING",
      "alarm_when": true,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "STAT external-control-missing bit must remain 0",
      "group": "chiller-stat-minor"
    },
    {
      "id": "lv1-health",
      "kind": "state",
      "label": "LV1 communication is unavailable",
      "pv": "BDX:PSU:LV1:COMM_OK",
      "alarm_when": false,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        },
        {
          "level": "MAJOR",
          "after_seconds": 60
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "LV1 COMM_OK must remain On (1)",
      "group": "lv1-health"
    },
    {
      "id": "lv2-health",
      "kind": "state",
      "label": "LV2 communication is unavailable",
      "pv": "BDX:PSU:LV2:COMM_OK",
      "alarm_when": false,
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 10
        },
        {
          "level": "MAJOR",
          "after_seconds": 60
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "LV2 COMM_OK must remain On (1)",
      "group": "lv2-health"
    },
    {
      "id": "lv1-heartbeat-stale",
      "kind": "stale",
      "label": "LV1 IOC heartbeat is stale",
      "pv": "BDX:PSU:LV1:HEARTBEAT",
      "stale_after_seconds": 10,
      "timestamp_mode": "change",
      "stages": [
        {
          "level": "MINOR",
          "after_seconds": 0
        },
        {
          "level": "MAJOR",
          "after_seconds": 50
        }
      ],
      "recovery_seconds": 5,
      "limit_description": "LV1 heartbeat must keep changing",
      "group": "lv1-health"
    },
    {
      "id": "lv2-heartbeat-stale",
      "kind": "stale",
