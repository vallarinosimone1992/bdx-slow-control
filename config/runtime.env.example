# BDX local runtime configuration.
#
# Copy this file to config/runtime.env and set this value to the IP address of
# the computer running the main IOC.

BDX_MAIN_HOST=

# The notifier shipped inside this repository is discovered automatically.
# Set this only to use a different installation.
BDX_NOTIFIER_DIR=

# Optional overrides. The default rules are notifier/alarms.json and the
# default secret file is $HOME/.config/bdx-notifier/config.env.
BDX_NOTIFIER_CONFIG=
BDX_NOTIFIER_ENV_FILE="$HOME/.config/bdx-notifier/config.env"

# Set true only for local validation without Telegram delivery.
BDX_NOTIFIER_DRY_RUN=false
